<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.metersphere.sql.mapper.ExtSqlDefinitionModuleMapper">
    <sql id="module_request">
        <where>
            <if test="request.projectId != null and request.projectId != ''">
                AND m.project_id = #{request.projectId}
            </if>
            <if test="request.keyword != null and request.keyword != ''">
                AND m.name like CONCAT('%', #{request.keyword},'%')
            </if>
            <if test="request.moduleIds != null and request.moduleIds.size() != 0">
                AND m.id IN
                <foreach collection="request.moduleIds" item="item" open="(" separator="," close=")">
                    #{item}
                </foreach>
            </if>

        </where>
    </sql>

    <select id="selectBaseByRequest" resultType="io.metersphere.system.dto.sdk.BaseTreeNode">
        SELECT m.id,
        m.parent_id AS parentId,
        m.name,
        m.pos,
        m.project_id,
        'MODULE' AS type
        FROM sql_definition_module m
        <include refid="module_request"/>
        ORDER BY pos
    </select>

    <select id="selectSqlDataByRequest" resultType="io.metersphere.sql.pojo.dto.SqlTreeNode">
        SELECT id,
        NAME,
        module_id AS parentId,
        'SQL' AS type,
        sql_method,
        sql_protocol
        FROM sql_definition
        where sql_definition.deleted = #{deleted}
        <include refid="io.metersphere.sql.mapper.ExtSqlDefinitionMapper.queryWhereCondition"/>
        ORDER BY pos DESC
    </select>

    <sql id="filters">
        <include refid="io.metersphere.sql.mapper.ExtSqlDefinitionMapper.filters"/>
    </sql>

    <sql id="combine">
        <include refid="io.metersphere.sql.mapper.ExtSqlDefinitionMapper.combine"/>
    </sql>

    <sql id="queryVersionCondition">
        <if test="request.versionId != null and request.versionId != ''">
            and ${versionTable}.version_id = #{request.versionId}
        </if>
        <if test="request.refId != null and request.refId != ''">
            and ${versionTable}.ref_id = #{request.refId}
        </if>
        <if test="request.versionId == null and request.refId == null">
            AND ${versionTable}.latest = 1
        </if>
    </sql>

    <select id="getMaxPosByParentId" resultType="java.lang.Long">
        SELECT max(pos)
        FROM sql_definition_module
        WHERE parent_id = #{0}
    </select>

    <select id="getNameInfoByIds" resultType="io.metersphere.sql.domain.SqlDefinitionModule">
        SELECT id, name
        FROM sql_definition_module
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

    <select id="selectNodeByIds" resultType="io.metersphere.system.dto.sdk.BaseTreeNode">
        SELECT m.id,
        m.parent_id AS parentId,
        m.name,
        m.pos,
        m.project_id,
        'MODULE' AS type
        FROM sql_definition_module m
        WHERE m.id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
        ORDER BY pos
    </select>

    <delete id="deleteByIds">
        DELETE
        FROM sql_definition_module
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <select id="selectChildrenIdsByParentIds" resultType="java.lang.String">
        SELECT id
        FROM sql_definition_module
        WHERE parent_id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

    <select id="countModuleIdByRequest" resultType="io.metersphere.project.dto.ModuleCountDTO">
        SELECT module_id AS moduleId, count(id) AS dataCount
        FROM sql_definition
        where sql_definition.deleted = #{deleted}
        <include refid="io.metersphere.sql.mapper.ExtSqlDefinitionMapper.queryWhereCondition"/>
        GROUP BY sql_definition.module_id
    </select>

    <select id="selectIdAndParentIdByRequest" resultType="io.metersphere.system.dto.sdk.BaseTreeNode">
        SELECT m.id,
        m.parent_id AS parentId
        FROM sql_definition_module m
        <include refid="module_request"/>
        ORDER BY pos
    </select>
</mapper>